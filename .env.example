PORT=4000

# MongoDB Atlas connection string. Use a dedicated database name (e.g.
# .../naijasafe?retryWrites=true&w=majority) — can be the same cluster
# SecureLink's backend uses, just a different database.
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/naijasafe?retryWrites=true&w=majority

# Africa's Talking credentials (SMS + USSD gateway)
AT_API_KEY=
AT_USERNAME=

# Shared secret that must be sent as the X-Sync-Key header on
# POST /api/sync-incident. Set the same value in SecureLink backend's
# NAIJASAFE_SYNC_KEY env var.
SYNC_SECRET=
